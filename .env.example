# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is ignored by git.
# ---------------------------------------------------------------

# PostgreSQL connection string.
# Supabase: Dashboard > Connect > Session pooler. URL-encode special characters in the password
# ($ -> %24, # -> %23, @ -> %40, ! -> %21). No anon key / JWT secret is needed.
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<URL-ENCODED-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30

# AI provider: groq (default) or openrouter — both use the OpenAI-compatible API
AI_PROVIDER=groq
AI_API_KEY=your-groq-or-openrouter-key
# Primary model + comma-separated fallbacks (tried in order if one fails / is rate-limited)
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODELS=openai/gpt-oss-20b
# Optional: override the provider base URL
# AI_BASE_URL=https://api.groq.com/openai/v1

# Secret that signs the login session cookie (any long random string)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ONE port serves both the API (/api/*) and the frontend
PORT=3000
NODE_ENV=development
