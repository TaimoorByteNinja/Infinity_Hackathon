{
  "name": "@novaworks/backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API, authentication, role-based access, persistence, and single-port server for the frontend.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"../frontend/**\" --exclude \"../node_modules/**\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../.env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset --force --skip-seed && npm run db:seed"
  },
  "dependencies": {
    "@novaworks/ai": "*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.76",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "typescript": "~6.0.2"
  }
}
